# Telegram Bot Configuration
BOT_TOKEN=your-telegram-bot-token-here
HOW_TO_ORDER_VIDEO_ID=your-telegram-file-id-here
SUPPORT_LINK=@LazR_Supports

# Brand Name (Optional) — lets this codebase be redeployed ("cloned") for a
# different business by only changing env vars. If unset, defaults to Blessing.Kh.
BRAND_NAME=Your Brand Name
BRAND_NAME_UPPER=YOUR BRAND SMM

# Channel & Admin Notification Group (Optional)
CHANNEL_LINK=https://t.me/your_public_channel
GROUP_CHAT_ID=your-admin-notification-chat-id

# Payment Merchant Config (Optional)
BAKONG_ACCOUNT_ID=your_bakong_account@bank
BAKONG_TOKEN=your-bakong-open-api-token
ACLEDA_MERCHANT_ID=your_acleda_merchant@aclb
ACLEDA_API_TOKEN=your-acleda-api-token
PAYWAY_LINK=https://link.payway.com.kh/your-merchant-link

# WebApp Portal URL (Optional — the deployed website/ WebApp for this instance)
WEB_APP_URL=https://your-app.onrender.com

# Supabase Database Configuration (Optional - falls back to local memory if empty)
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Admin Access (Optional - comma-separated Telegram numeric user IDs)
# If unset, the bot falls back to its built-in default admin IDs.
# Set this to take exclusive control of who has admin access.
ADMIN_IDS=your-telegram-user-id-here

# Host Support Access (Optional - comma-separated Telegram numeric user IDs)
# Only relevant for white-label clones (see NEW_CLIENT_SETUP.md): the hosting
# provider's own ID(s), kept as admin on every clone they host for support/billing.
# Leave unset for a self-owned deployment.
HOST_SUPER_ADMIN_ID=
